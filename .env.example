# Copie este archivo a .env y ajuste los valores. Nunca suba .env al repositorio.

# PostgreSQL privado. Desarrollo local: contenedor Docker crm_premium_pg (puerto 5433).
DATABASE_URL=postgresql://crm_premium:CHANGE_ME@localhost:5433/crm_premium

# Clave de firma de la aplicación. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Zona IANA del negocio (se edita también desde Ajustes; ésta es la inicial).
CRM_ZONE=America/Guayaquil

# Cookie de sesión con Secure=true sólo detrás de HTTPS en producción.
COOKIE_SECURE=false
